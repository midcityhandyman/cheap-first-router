# All settings are optional. The mocks need no keys and no network.
# Share of passing cheap drafts that the strong model reviews (0 to 1).
CFR_SAMPLE_RATE=0.2
# Seed for the deterministic sample and for mock fault injection.
CFR_SEED=0
# Comma separated tags that pin a task to the strong model.
CFR_SENSITIVE_TAGS=sensitive

# If you add a real provider, read its key from the environment here.
# Never commit a real key. Example placeholder only:
# STRONG_PROVIDER_API_KEY=replace-me
# CHEAP_PROVIDER_API_KEY=replace-me
